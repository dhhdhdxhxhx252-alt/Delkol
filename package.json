{
  "name": "delkol",
  "productName": "Delkol",
  "version": "1.2.0",
  "description": "Delkol. Ваше пространство для макросов, групп и комфортной игры.",
  "author": "Delkol",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "test:engine": "esbuild scripts/engine-entry.ts --bundle --format=esm --outfile=scripts/.engine-tmp/engine-bundle.js && node scripts/engine-test.mjs",
    "dev:electron": "npm run build:web && electron .",
    "dev:full": "concurrently -k \"vite --port 5183 --strictPort\" \"wait-on tcp:5183 && cross-env VITE_DEV_SERVER_URL=http://localhost:5183 electron .\"",
    "build": "npm run build:web && npm run build:exe",
    "build:web": "vite build",
    "build:exe": "electron-builder --win nsis portable --config electron-builder.yml",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0",
    "wait-on": "^8.0.5"
  }
}
